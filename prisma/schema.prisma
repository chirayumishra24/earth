datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model GameSession {
  id                    String   @id @default(uuid())
  createdAt             DateTime @default(now())
  round                 Int      @default(1)
  northStarScore        Int      @default(0)
  earthExplorersScore   Int      @default(0)
  winner                String?
}

model Question {
  id            String   @id @default(uuid())
  topic         String
  difficulty    String
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  explanation   String?
  visualType    String?
}
